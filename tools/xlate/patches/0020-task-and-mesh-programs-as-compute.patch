+using System.Collections.Generic;
+using static Spv.Specification;
+using SpvInstruction = Spv.Generator.Instruction;
+using SpvLiteralInteger = Spv.Generator.LiteralInteger;
+
+namespace Ryujinx.Graphics.Shader.CodeGen.Spirv
+{
+    // Task and mesh programs of ocarina-of-time-recomp (docs/mesh.md; ShaderDefinitions.MeshStage): the output
+    // variables of a mesh entry point and the task payload, declared on first use. Mesh outputs are arrays over the
+    // maximum vertex (and primitive) count: the position (BuiltIn Position), one vec4 array per user output location,
+    // the triangle indices (BuiltIn PrimitiveTriangleIndicesEXT); the payload is a uint array in TaskPayloadWorkgroupEXT,
+    // the same declaration in the task and the mesh stage.
+    partial class CodeGenContext
+    {
+        private readonly Dictionary<int, SpvInstruction> _meshOutputs = new();
+        private SpvInstruction _meshPrimitiveIndices;
+        private SpvInstruction _taskPayload;
+
+        public void UseMeshShading()
+        {
+            AddCapability(Capability.MeshShadingEXT);
+            AddExtension("SPV_EXT_mesh_shader");
+        }
+
+        // location -1: the position.
+        public SpvInstruction GetMeshOutput(int location)
+        {
+            if (_meshOutputs.TryGetValue(location, out SpvInstruction variable))
+            {
+                return variable;
+            }
+
+            SpvInstruction vec4 = TypeVector(TypeFP32(), 4);
+            SpvInstruction array = TypeArray(vec4, Constant(TypeU32(), Definitions.MeshMaxVertices));
+            variable = Variable(TypePointer(StorageClass.Output, array), StorageClass.Output);
+            AddGlobalVariable(variable);
+
+            if (location < 0)
+            {
+                Decorate(variable, Decoration.BuiltIn, (SpvLiteralInteger)BuiltIn.Position);
+                Name(variable, "mesh_position");
+            }
+            else
+            {
+                Decorate(variable, Decoration.Location, (SpvLiteralInteger)location);
+                Name(variable, $"mesh_out{location}");
+            }
+
+            _meshOutputs.Add(location, variable);
+
+            return variable;
+        }
+
+        public SpvInstruction GetMeshPrimitiveIndices()
+        {
+            if (_meshPrimitiveIndices == null)
+            {
+                SpvInstruction uvec3 = TypeVector(TypeU32(), 3);
+                SpvInstruction array = TypeArray(uvec3, Constant(TypeU32(), Definitions.MeshMaxPrimitives));
+                _meshPrimitiveIndices = Variable(TypePointer(StorageClass.Output, array), StorageClass.Output);
+                AddGlobalVariable(_meshPrimitiveIndices);
+                Decorate(_meshPrimitiveIndices, Decoration.BuiltIn, (SpvLiteralInteger)BuiltIn.PrimitiveTriangleIndicesEXT);
+                Name(_meshPrimitiveIndices, "mesh_triangles");
+            }
+
+            return _meshPrimitiveIndices;
+        }
+
+        public SpvInstruction GetTaskPayload()
+        {
+            if (_taskPayload == null)
+            {
+                int words = Definitions.TaskPayloadWords > 0 ? Definitions.TaskPayloadWords : 1;
+                SpvInstruction array = TypeArray(TypeU32(), Constant(TypeU32(), words));
+                _taskPayload = Variable(TypePointer(StorageClass.TaskPayloadWorkgroupEXT, array), StorageClass.TaskPayloadWorkgroupEXT);
+                AddGlobalVariable(_taskPayload);
+                Name(_taskPayload, "task_payload");
+            }
+
+            return _taskPayload;
+        }
+    }
+}
