+using Ryujinx.Graphics.Shader.Decoders;
+using Ryujinx.Graphics.Shader.IntermediateRepresentation;
+using Ryujinx.Graphics.Shader.Translation;
+using static Ryujinx.Graphics.Shader.Instructions.InstEmitHelper;
+using static Ryujinx.Graphics.Shader.IntermediateRepresentation.OperandHelper;
+
+namespace Ryujinx.Graphics.Shader.Instructions
+{
+    // Task and mesh programs of ocarina-of-time-recomp (docs/mesh.md), translated as compute. The SM86 lowering passes
+    // their stage buffer ops (ISBERD / ISBEWR) as Isbe and marks the end every EXIT branches to with MeshEpilogue
+    // (runtime/sm86_lower.h). The stage buffer is emulated in shared memory from ShaderDefinitions.MeshBufferBase:
+    //   mesh: the vertex outputs (ATTR) at 0, one 0x80-byte line per output component and group of 32 vertices
+    //         (vertex v's line k at (v >> 5) * lines * 0x80 + k * 0x80 + (v & 31) * 4), then the primitive map (MAP):
+    //         its count word, then three index bytes per triangle from byte 4;
+    //   task: the task's output (TASK): the mesh workgroup count at 4, the payload from 0x10.
+    // The epilogue copies the buffer into the stage's outputs (MeshStoreVertex, MeshStorePrimitive, SetMeshOutputs) or
+    // the payload into the task payload and launches the mesh workgroups (TaskPayloadStore, EmitMeshTasks), with no
+    // control flow: every vertex slot is written, and primitives past the count get the degenerate triangle 0, 0, 0.
+    static partial class InstEmit
+    {
+        private const int SpaceAttr = 0xf, SpaceTask = 7, SpaceMap32 = 1, SpaceMapU8 = 0;
+
+        private static int MeshAttrBytes(ShaderDefinitions d)
+        {
+            return d.MeshMaxVertices * d.MeshOutputLines.Length * 4;
+        }
+
+        // Isbe: bits 0-7 the register read into or written, 8-15 the address register, 20-43 the byte offset, 44-47
+        // the space, 48 a write.
+        public static void Isbe(EmitterContext context)
+        {
+            ulong op = context.CurrOp.RawOpCode;
+            int reg = (int)(op & 0xff), ra = (int)((op >> 8) & 0xff);
+            int offset = (int)((op >> 20) & 0xffffff), space = (int)((op >> 44) & 0xf);
+            bool write = ((op >> 48) & 1) != 0;
+            ShaderDefinitions d = context.TranslatorContext.Definitions;
+            int id = context.ResourceManager.SharedMemoryId;
+            bool rz = ra == RegisterConsts.RegisterZeroIndex;
+            Operand addr = rz ? Const(offset) : context.IAdd(GetSrcReg(context, ra), Const(offset));
+
+            if (!write)
+            {
+                Operand value;
+
+                if ((space == SpaceAttr || space == SpaceTask) && rz && offset == 0)
+                {
+                    value = context.Load(StorageKind.Input, IoVariable.CtaId, null, Const(0));   // the workgroup index
+                }
+                else if (space == SpaceTask && d.MeshStage == 2)
+                {
+                    Operand index = context.ShiftRightU32(context.ISubtract(addr, Const(0x10)), Const(2));
+                    value = context.Add(Instruction.TaskPayloadLoad, Local(), index);
+                }
+                else
+                {
+                    context.TranslatorContext.GpuAccessor.Log($"ISBERD of space {space:x} at {offset:x}: read as 0");
+                    value = Const(0);
+                }
+
+                context.Copy(GetDest(reg), value);
+                return;
+            }
+
+            Operand data = GetSrcReg(context, reg);
+            int baseBytes = d.MeshBufferBase;
+
+            switch (space)
+            {
+                case SpaceAttr when d.MeshStage == 2:
+                    context.Store(StorageKind.SharedMemory, id, context.ShiftRightU32(context.IAdd(addr, Const(baseBytes)), Const(2)), data);
+                    break;
+                case SpaceMapU8 when d.MeshStage == 2:
+                    context.Store(StorageKind.SharedMemory8, id, context.IAdd(addr, Const(baseBytes + MeshAttrBytes(d))), data);
+                    break;
+                case SpaceMap32 when d.MeshStage == 2 && rz && offset == 3:
+                    context.Store(StorageKind.SharedMemory, id, Const((baseBytes + MeshAttrBytes(d)) >> 2), data);   // the count
+                    break;
+                case SpaceTask when d.MeshStage == 1:
+                    context.Store(StorageKind.SharedMemory, id, context.ShiftRightU32(context.IAdd(addr, Const(baseBytes)), Const(2)), data);
+                    break;
+                default:
+                    context.TranslatorContext.GpuAccessor.Log($"ISBEWR of space {space:x} at {offset:x} in mesh stage {d.MeshStage}: dropped");
+                    break;
+            }
+        }
+
+        public static void MeshEpilogue(EmitterContext context)
+        {
+            ShaderDefinitions d = context.TranslatorContext.Definitions;
+            int id = context.ResourceManager.SharedMemoryId;
+
+            context.Barrier();
+
+            Operand tid = context.Load(StorageKind.Input, IoVariable.ThreadId, null, Const(0));
+
+            if (d.MeshStage == 2)
+            {
+                int lines = d.MeshOutputLines.Length;
+                int mapBase = d.MeshBufferBase + MeshAttrBytes(d);
+                Operand count = context.Load(StorageKind.SharedMemory, id, Const(mapBase >> 2));
+                Operand t4 = context.ShiftLeft(tid, Const(2));
+
+                context.Add(Instruction.SetMeshOutputs, null, Const(d.MeshMaxVertices), Const(d.MeshMaxPrimitives));
+
+                for (int j = 0; j < d.MeshMaxVertices / 32; j++)
+                {
+                    Operand v = context.IAdd(tid, Const(32 * j));
+
+                    for (int k = 0; k < lines; k++)
+                    {
+                        if (d.MeshOutputLines[k] < 0)
+                        {
+                            continue;
+                        }
+
+                        Operand byteAddr = context.IAdd(t4, Const(d.MeshBufferBase + j * lines * 0x80 + k * 0x80));
+                        Operand value = context.Load(StorageKind.SharedMemory, id, context.ShiftRightU32(byteAddr, Const(2)));
+
+                        context.Add(Instruction.MeshStoreVertex, null, Const(d.MeshOutputLines[k]), v, value);
+                    }
+                }
+
+                for (int j = 0; j < d.MeshMaxPrimitives / 32; j++)
+                {
+                    Operand p = context.IAdd(tid, Const(32 * j));
+                    Operand valid = context.ICompareLessUnsigned(p, count);
+                    Operand first = context.IAdd(context.IMultiply(p, Const(3)), Const(mapBase + 4));
+                    Operand[] index = new Operand[3];
+
+                    for (int i = 0; i < 3; i++)
+                    {
+                        Operand b = context.IAdd(first, Const(i));
+                        Operand word = context.Load(StorageKind.SharedMemory, id, context.ShiftRightU32(b, Const(2)));
+                        Operand shift = context.ShiftLeft(context.BitwiseAnd(b, Const(3)), Const(3));
+                        Operand value = context.BitwiseAnd(context.ShiftRightU32(word, shift), Const(0xff));
+
+                        index[i] = context.ConditionalSelect(valid, value, Const(0));
+                    }
+
+                    context.Add(Instruction.MeshStorePrimitive, null, p, index[0], index[1], index[2]);
+                }
+            }
+            else if (d.MeshStage == 1)
+            {
+                Operand count = context.Load(StorageKind.SharedMemory, id, Const((d.MeshBufferBase + 4) >> 2));
+
+                for (int j = 0; j < d.TaskPayloadWords / 32; j++)
+                {
+                    Operand w = context.IAdd(tid, Const(32 * j));
+                    Operand value = context.Load(StorageKind.SharedMemory, id, context.IAdd(w, Const((d.MeshBufferBase + 0x10) >> 2)));
+
+                    context.Add(Instruction.TaskPayloadStore, null, w, value);
+                }
+
+                context.Barrier();
+                context.Add(Instruction.EmitMeshTasks, null, count);
+            }
+        }
+    }
